#!/bin/sh
set -eu
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "Commit blocked: install Gitleaks 8.30.1 or newer to run privacy checks." >&2
    exit 1
fi
root=$(git rev-parse --show-toplevel)
if [ -n "$(git ls-files --cached -- 'docs-private' 'docs-private/**')" ]; then
    echo "Commit blocked: docs-private must remain untracked. Unstage its files." >&2
    exit 1
fi
gitleaks git "$root" --pre-commit --staged --config "$root/.gitleaks.toml" --redact --no-banner --ignore-gitleaks-allow
exec gitleaks git "$root" --pre-commit --staged --config "$root/.gitleaks-secrets.toml" --redact --no-banner --ignore-gitleaks-allow
